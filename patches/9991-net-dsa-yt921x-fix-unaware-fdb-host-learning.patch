From: OpenWrt Builder <builder@openwrt.org>
Subject: [PATCH] net: dsa: yt921x: fix FDB/MDB vid handling and 32-bit register truncation

1. yt921x_fdb_add_index_in12() took u16 ctrl1, u16 ctrl2, truncating the upper
   16 bits (including YT921X_FDB_IO1_STATUS_M, YT921X_FDB_IO1_FID_M, and
   YT921X_FDB_IO2_EGR_PORTS_M) whenever an existing FDB/MDB entry was updated.
   Change ctrl1 and ctrl2 parameters to u32.
2. When bridge VLAN filtering is disabled, DSA passes vid=0 to port_fdb_add/del
   and port_mdb_add/del, whereas YT9215 hardware learning uses YT921X_VID_UNWARE
   (4095). Map vid=0 to YT921X_VID_UNWARE via yt921x_fdb_vid(vid).

--- a/drivers/net/dsa/yt921x.c
+++ b/drivers/net/dsa/yt921x.c
@@ -2978,8 +2978,8 @@ static int yt921x_fdb_wait(struct yt921x_priv *priv, u32 *valp)
 }
 
 static int
-yt921x_fdb_add_index_in12(struct yt921x_priv *priv, u16 index, u16 ctrl1,
-			  u16 ctrl2)
+yt921x_fdb_add_index_in12(struct yt921x_priv *priv, u16 index, u32 ctrl1,
+			  u32 ctrl2)
 {
 	u32 ctrl;
 	u32 val;
@@ -3166,6 +3166,11 @@ static void yt921x_dsa_port_fast_age(struct dsa_switch *ds, int port)
 		dev_err(dev, "%s: %i\n", __func__, res);
 }
 
+static u16 yt921x_fdb_vid(u16 vid)
+{
+	return vid ? vid : YT921X_VID_UNWARE;
+}
+
 static int
 yt921x_dsa_port_fdb_del(struct dsa_switch *ds, int port,
 			const unsigned char *addr, u16 vid, struct dsa_db db)
@@ -3174,7 +3179,7 @@ yt921x_dsa_port_fdb_del(struct dsa_switch *ds, int port,
 	int res;
 
 	mutex_lock(&priv->reg_lock);
-	res = yt921x_fdb_leave(priv, addr, vid, BIT(port));
+	res = yt921x_fdb_leave(priv, addr, yt921x_fdb_vid(vid), BIT(port));
 	mutex_unlock(&priv->reg_lock);
 
 	return res;
@@ -3188,7 +3193,7 @@ yt921x_dsa_port_fdb_add(struct dsa_switch *ds, int port,
 	int res;
 
 	mutex_lock(&priv->reg_lock);
-	res = yt921x_fdb_join(priv, addr, vid, BIT(port));
+	res = yt921x_fdb_join(priv, addr, yt921x_fdb_vid(vid), BIT(port));
 	mutex_unlock(&priv->reg_lock);
 
 	return res;
@@ -3204,7 +3209,7 @@ yt921x_dsa_port_mdb_del(struct dsa_switch *ds, int port,
 	int res;
 
 	mutex_lock(&priv->reg_lock);
-	res = yt921x_fdb_leave(priv, addr, vid, BIT(port));
+	res = yt921x_fdb_leave(priv, addr, yt921x_fdb_vid(vid), BIT(port));
 	mutex_unlock(&priv->reg_lock);
 
 	return res;
@@ -3221,7 +3226,7 @@ yt921x_dsa_port_mdb_add(struct dsa_switch *ds, int port,
 	int res;
 
 	mutex_lock(&priv->reg_lock);
-	res = yt921x_fdb_join(priv, addr, vid, BIT(port));
+	res = yt921x_fdb_join(priv, addr, yt921x_fdb_vid(vid), BIT(port));
 	mutex_unlock(&priv->reg_lock);
 
 	return res;
