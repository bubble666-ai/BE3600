				};

				ethernet-ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					ethernet-port@0 {
						reg = <0x00>;
						label = "lan1";
						phy-mode = "internal";
						phy-handle = <0x2e>;
					};

					ethernet-port@1 {
						reg = <0x01>;
						label = "lan2";
						phy-mode = "internal";
						phy-handle = <0x2f>;
					};

					ethernet-port@2 {
						reg = <0x02>;
						label = "lan3";
						phy-mode = "internal";
						phy-handle = <0x30>;
					};

					ethernet-port@3 {
						reg = <0x03>;
						label = "lan4";
						phy-mode = "internal";
						phy-handle = <0x31>;
					};

					ethernet-port@8 {
						reg = <0x08>;
						phy-mode = "2500base-x";
						ethernet = <0x32>;

						fixed-link {
							speed = <0x9c4>;
							full-duplex;
							pause;
						};
					};
				};
			};

			ethernet-phy@4 {
				compatible = "ethernet-phy-id4f51.ea19";
				reg = <0x04>;
				reset-gpios = <0x14 0x16 0x01>;
				reset-assert-us = <0x2710>;
				reset-deassert-us = <0x186a0>;
				phandle = <0x1f>;
			};
		};

		clock-controller@39b00000 {
			compatible = "qcom,ipq5332-nsscc";
			reg = <0x39b00000 0x80000>;
			clocks = <0x33 0x34 0x0a 0xad 0x35 0x00 0x35 0x01 0x36 0x00 0x36 0x01 0x15 0x0a 0x2e 0x0a 0x31 0x0a 0x34 0x0a 0x33 0x0a 0x77 0x0a 0x76>;
			clock-names = "cmn_pll_nss_clk_200m", "cmn_pll_nss_clk_300m", "gcc_gpll0_out_aux", "uniphy0_rx", "uniphy0_tx", "uniphy1_rx", "uniphy1_tx", "xo", "bus", "nssnoc", "nssnoc_snoc", "nssnoc_snoc_1", "snoc_nssnoc", "snoc_nssnoc_1";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#interconnect-cells = <0x01>;
			phandle = <0x1c>;
		};

		wifi-qcn6432 {
			compatible = "qcom,qcn6432-wifi";
			msi-parent = <0x25>;
			interrupts-extended = <0x26 0x10 0x00 0x26 0x11 0x00 0x26 0x14 0x00 0x26 0x13 0x00>;
			interrupt-names = "fatal", "ready", "spawn", "stop-ack";
			qcom,smem-states = <0x27 0x10 0x27 0x11 0x27 0x12>;
			qcom,smem-state-names = "shutdown", "stop", "spawn";
			firmware-name = "ath12k/QCN6432/hw1.0/q6_fw2.mdt", "ath12k/QCN6432/hw1.0/iu_fw.mdt";
			memory-region = <0x28 0x37 0x38 0x2b 0x39>;
			memory-region-names = "q6-region", "m3-dump", "q6-caldb", "mlo-global-mem", "host-ddr-mem";
			qcom,bdf-address-offset = <0x00>;
			qcom,board-id = <0x60>;
			local-mac-address = [a0 9f 7a 66 fc cf];
			qcom,legacy-userpd-bootinfo;
			qcom,ath12k-fw-memory-mode = <0x01>;
			qcom,rproc = <0x2c>;
			status = "okay";
		};
	};

	thermal-zones {

		rfa-0-thermal {
			thermal-sensors = <0x3a 0x0b>;

			trips {

				rfa-0-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		rfa-1-thermal {
			thermal-sensors = <0x3a 0x0c>;

			trips {

				rfa-1-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		misc-thermal {
			thermal-sensors = <0x3a 0x0d>;

			trips {

				misc-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu-top-thermal {
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x3a 0x0e>;

			trips {

				cpu-top-critical {
					temperature = <0x1c138>;
					hysteresis = <0x3e8>;
					type = "critical";
				};

				cpu-passive {
					temperature = <0x19a28>;
					hysteresis = <0x3e8>;
					type = "passive";
				};
			};
		};

		top-glue-thermal {
			thermal-sensors = <0x3a 0x0f>;

			trips {

				top-glue-critical {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	aliases {
		serial0 = "/soc@0/serial@78af000";
		led-boot = "/leds/led-red";
		led-failsafe = "/leds/led-red";
		led-running = "/leds/led-green";
		led-upgrade = "/leds/led-blue";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyMSM0,115200n8 earlycon root=/dev/ram0 rdinit=/sbin/init clk_ignore_unused ";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x3b>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <0x14 0x18 0x01>;
			linux,code = <0x198>;
			debounce-interval = <0x3c>;
		};

		wps {
			label = "wps";
			gpios = <0x14 0x23 0x01>;
			linux,code = <0x211>;
			debounce-interval = <0x3c>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <0x3c>;
		pinctrl-names = "default";

		led-red {
			color = <0x01>;
			function = "status";
			gpios = <0x14 0x27 0x00>;
			default-state = "on";
		};

		led-green {
			color = <0x02>;
			function = "status";
			gpios = <0x14 0x24 0x00>;
			default-state = "off";
		};

		led-blue {
			color = <0x03>;
			function = "status";
			gpios = <0x14 0x1f 0x00>;
			default-state = "off";
		};
	};
};
