/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "D-Link DIR-BE364K";
	compatible = "dlink,dir-be364k", "qcom,ipq5332";

	clocks {

		ref-48mhz-clk {
			compatible = "fixed-factor-clock";
			clocks = <0x02>;
			#clock-cells = <0x00>;
			clock-div = <0x01>;
			clock-mult = <0x01>;
			phandle = <0x03>;
		};

		cmn-pll-nss-200m-clk {
			compatible = "fixed-clock";
			clock-frequency = <0xbebc200>;
			#clock-cells = <0x00>;
			phandle = <0x33>;
		};

		cmn-pll-nss-300m-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x11e1a300>;
			#clock-cells = <0x00>;
			phandle = <0x34>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7d00>;
			phandle = <0x16>;
		};

		xo-board-clk {
			compatible = "fixed-factor-clock";
			clocks = <0x03>;
			#clock-cells = <0x00>;
			clock-div = <0x02>;
			clock-mult = <0x01>;
			phandle = <0x15>;
		};

		xo-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x2dc6c00>;
			phandle = <0x02>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x00>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			operating-points-v2 = <0x06>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x01>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			operating-points-v2 = <0x06>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x02>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			operating-points-v2 = <0x06>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x03>;
			enable-method = "psci";
			next-level-cache = <0x04>;
			clocks = <0x05 0x01>;
			operating-points-v2 = <0x06>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			phandle = <0x04>;
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-ipq5332", "qcom,scm";
			qcom,dload-mode = <0x07 0x6100>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x00>;
	};

	opp-table-cpu {
		compatible = "operating-points-v2-kryo-cpu";
		opp-shared;
		nvmem-cells = <0x08>;
		phandle = <0x06>;

		opp-1100000000 {
			opp-hz = <0x00 0x4190ab00>;
			opp-supported-hw = <0x07>;
			clock-latency-ns = <0x30d40>;
		};

		opp-1500000000 {
			opp-hz = <0x00 0x59682f00>;
			opp-supported-hw = <0x03>;
			clock-latency-ns = <0x30d40>;
		};
	};

	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		bootloader@4a100000 {
			reg = <0x00 0x4a100000 0x00 0x400000>;
			no-map;
		};

		sbl@4a500000 {
			reg = <0x00 0x4a500000 0x00 0x100000>;
			no-map;
		};

		tz@4a600000 {
			reg = <0x00 0x4a600000 0x00 0x200000>;
			no-map;
		};

		smem@4a800000 {
			compatible = "qcom,smem";
			reg = <0x00 0x4a800000 0x00 0x100000>;
			no-map;
			hwlocks = <0x09 0x03>;
		};

		wcss@4a900000 {
			reg = <0x00 0x4a900000 0x00 0x2300000>;
			no-map;
			phandle = <0x28>;
		};

		m3-dump@4cc00000 {
			reg = <0x00 0x4cc00000 0x00 0x100000>;
			no-map;
			phandle = <0x29>;
		};

		q6-etr-dump@4cd00000 {
			reg = <0x00 0x4cd00000 0x00 0x100000>;
			no-map;
		};

		q6-caldb@4f000000 {
			reg = <0x00 0x4f000000 0x00 0x500000>;
			no-map;
			phandle = <0x2a>;
		};

		q6-qcn6432-data@4ce00000 {
			reg = <0x00 0x4ce00000 0x00 0x1000000>;
			no-map;
			phandle = <0x39>;
		};

		m3-dump-qcn6432@4de00000 {
			reg = <0x00 0x4de00000 0x00 0x100000>;
			no-map;
			phandle = <0x37>;
		};

		q6-qcn6432-etr@4df00000 {
			reg = <0x00 0x4df00000 0x00 0x100000>;
			no-map;
			phandle = <0x38>;
		};

		q6-qcn6432-caldb@4f500000 {
			reg = <0x00 0x4f500000 0x00 0x500000>;
			no-map;
		};

		ramoops@4fa00000 {
			compatible = "ramoops";
			reg = <0x00 0x4fa00000 0x00 0x100000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x00>;
			ecc-size = <0x00>;
		};

		mlo-global-mem@4e000000 {
			reg = <0x00 0x4e000000 0x00 0x900000>;
			no-map;
			phandle = <0x2b>;
		};
	};

	smp2p-wcss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x1a2 0x01>;
		mboxes = <0x05 0x09>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x27>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x26>;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;

		phy@7b000 {
			compatible = "qcom,ipq5332-usb-hsphy";
			reg = <0x7b000 0x12c>;
			clocks = <0x0a 0x91>;
			resets = <0x0a 0x6e>;
			#phy-cells = <0x00>;
			status = "disabled";
			phandle = <0x23>;
		};

		clock-controller@9b000 {
			compatible = "qcom,ipq5332-cmn-pll";
			reg = <0x9b000 0x800>;
			clocks = <0x03 0x0a 0x1e 0x0a 0x20>;
			clock-names = "ref", "ahb", "sys";
			#clock-cells = <0x01>;
			assigned-clocks = <0x0b 0x00>;
			assigned-clock-rates-u64 = <0x01 0x65a0bc00>;
			phandle = <0x0b>;
		};

		efuse@a4000 {
			compatible = "qcom,ipq5332-qfprom", "qcom,qfprom";
			reg = <0xa4000 0x721>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			cpu-speed-bin@1d {
				reg = <0x1d 0x02>;
				bits = <0x07 0x02>;
				phandle = <0x08>;
			};

			s11@3a5 {
				reg = <0x3a5 0x01>;
				bits = <0x04 0x04>;
				phandle = <0x0f>;
			};

			s12@3a6 {
				reg = <0x3a6 0x01>;
				bits = <0x00 0x04>;
				phandle = <0x10>;
			};

			s13@3a6 {
				reg = <0x3a6 0x01>;
				bits = <0x04 0x04>;
				phandle = <0x11>;
			};

			s14@3ad {
				reg = <0x3ad 0x02>;
				bits = <0x07 0x04>;
				phandle = <0x12>;
			};

			s15@3ae {
				reg = <0x3ae 0x01>;
				bits = <0x03 0x04>;
				phandle = <0x13>;
			};

			mode@3e1 {
				reg = <0x3e1 0x01>;
				bits = <0x00 0x03>;
				phandle = <0x0c>;
			};

			base0@3e1 {
				reg = <0x3e1 0x02>;
				bits = <0x03 0x0a>;
				phandle = <0x0d>;
			};

			base1@3e2 {
				reg = <0x3e2 0x02>;
				bits = <0x05 0x0a>;
				phandle = <0x0e>;
			};
		};

		rng@e3000 {
			compatible = "qcom,ipq5332-trng", "qcom,trng";
			reg = <0xe3000 0x1000>;
			clocks = <0x0a 0x59>;
			clock-names = "core";
		};

		thermal-sensor@4a9000 {
			compatible = "qcom,ipq5332-tsens";
			reg = <0x4a9000 0x1000 0x4a8000 0x1000>;
			interrupts = <0x00 0x140 0x04>;
			interrupt-names = "combined";
			nvmem-cells = <0x0c 0x0d 0x0e 0x0f 0x10 0x11 0x12 0x13>;
			nvmem-cell-names = "mode", "base0", "base1", "tsens_sens11_off", "tsens_sens12_off", "tsens_sens13_off", "tsens_sens14_off", "tsens_sens15_off";
			#qcom,sensors = <0x05>;
			#thermal-sensor-cells = <0x01>;
			phandle = <0x3a>;
		};

		phy@4b0000 {
			compatible = "qcom,ipq5332-uniphy-pcie-phy";
			reg = <0x4b0000 0x800>;
			clocks = <0x0a 0x3d 0x0a 0x49>;
			resets = <0x0a 0x37 0x0a 0x42 0x0a 0x38>;
			reset-names = "phy", "phy_ahb", "phy_phy";
			#clock-cells = <0x00>;
			#phy-cells = <0x00>;
			num-lanes = <0x01>;
			status = "disabled";
			phandle = <0x19>;
		};

		phy@4b1000 {
			compatible = "qcom,ipq5332-uniphy-pcie-phy";
			reg = <0x4b1000 0x1000>;
			clocks = <0x0a 0x52 0x0a 0x51>;
			resets = <0x0a 0x4b 0x0a 0x4a 0x0a 0x4c>;
			reset-names = "phy", "phy_ahb", "phy_phy";
			#clock-cells = <0x00>;
			#phy-cells = <0x00>;
			num-lanes = <0x02>;
			status = "disabled";
			phandle = <0x17>;
		};

		phy@4b1800 {
			compatible = "qcom,ipq5332-uniphy-pcie-phy";
			reg = <0x4b1800 0x800>;
			clocks = <0x0a 0x46 0x0a 0x78 0x0a 0x79 0x0a 0x51>;
			resets = <0x0a 0x40 0x0a 0x4a>;
			reset-names = "phy", "phy_ahb";
			#clock-cells = <0x00>;
			#phy-cells = <0x00>;
			num-lanes = <0x01>;
			status = "disabled";
			phandle = <0x18>;
		};

		pinctrl@1000000 {
			compatible = "qcom,ipq5332-tlmm";
			reg = <0x1000000 0x300000>;
			interrupts = <0x00 0xf9 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x14 0x00 0x00 0x35>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x14>;

			serial0-state {
				pins = "gpio18", "gpio19";
				function = "blsp0_uart0";
				drive-strength = <0x08>;
				bias-pull-up;
				phandle = <0x1a>;
			};

			mdio0-state {

				mux_0 {
					pins = "gpio25";
					function = "mdc0";
					drive-strength = <0x08>;
					bias-disable;
				};

				mux_1 {
					pins = "gpio26";
					function = "mdio0";
					drive-strength = <0x08>;
					bias-pull-up;
				};
			};

			mdio1-state {
				phandle = <0x2d>;

				mux_0 {
					pins = "gpio27";
					function = "mdc1";
					drive-strength = <0x08>;
					bias-disable;
				};

				mux_1 {
					pins = "gpio28";
					function = "mdio1";
					drive-strength = <0x08>;
					bias-pull-up;
				};
			};

			button-state {
				pins = "gpio24", "gpio35";
				function = "gpio";
				drive-strength = <0x08>;
				bias-pull-up;
				phandle = <0x3b>;
			};

			leds-state {
				pins = "gpio31", "gpio36", "gpio39";
				function = "gpio";
				drive-strength = <0x08>;
				bias-pull-down;
				phandle = <0x3c>;
			};

			qspi-nand-state {
				phandle = <0x21>;

				qspi_clock {
					pins = "gpio13";
					function = "qspi_clk";
					drive-strength = <0x08>;
					bias-disable;
				};

				qspi_cs {
					pins = "gpio12";
					function = "qspi_cs";
					drive-strength = <0x08>;
					bias-disable;
				};

				qspi_data {
					pins = "gpio8", "gpio9", "gpio10", "gpio11";
					function = "qspi_data";
					drive-strength = <0x08>;
					bias-disable;
				};
			};
		};

		clock-controller@1800000 {
			compatible = "qcom,ipq5332-gcc";
			reg = <0x1800000 0x80000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#interconnect-cells = <0x01>;
			clocks = <0x15 0x16 0x17 0x18 0x19>;
			phandle = <0x0a>;
		};

		hwlock@1905000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x1905000 0x20000>;
			#hwlock-cells = <0x01>;
			phandle = <0x09>;
		};

		syscon@1937000 {
			compatible = "qcom,tcsr-ipq5332", "syscon";
			reg = <0x1937000 0x21000>;
			phandle = <0x07>;
		};

		pwm@1941010 {
			compatible = "qcom,ipq5332-pwm", "qcom,ipq6018-pwm";
			reg = <0x1941010 0x20>;
			clocks = <0x0a 0x06>;
			assigned-clocks = <0x0a 0x06>;
			assigned-clock-rates = <0x5f5e100>;
			#pwm-cells = <0x03>;
			status = "disabled";
		};

		mmc@7804000 {
			compatible = "qcom,ipq5332-sdhci", "qcom,sdhci-msm-v5";
			reg = <0x7804000 0x1000 0x7805000 0x1000>;
			interrupts = <0x00 0x139 0x04 0x00 0x13c 0x04>;
			interrupt-names = "hc_irq", "pwr_irq";
			clocks = <0x0a 0x71 0x0a 0x72 0x15>;
			clock-names = "iface", "core", "xo";
			status = "disabled";
		};

		dma-controller@7884000 {
			compatible = "qcom,bam-v1.7.0";
			reg = <0x7884000 0x1d000>;
			interrupts = <0x00 0x121 0x04>;
			clocks = <0x0a 0x0a>;
			clock-names = "bam_clk";
			#dma-cells = <0x01>;
			qcom,ee = <0x00>;
			phandle = <0x1b>;
		};

		serial@78af000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x78af000 0x200>;
			interrupts = <0x00 0x122 0x04>;
			clocks = <0x0a 0x15 0x0a 0x0a>;
			clock-names = "core", "iface";
			status = "okay";
			pinctrl-0 = <0x1a>;
			pinctrl-names = "default";
		};

		serial@78b0000 {
			compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
			reg = <0x78b0000 0x200>;
			interrupts = <0x00 0x123 0x04>;
			clocks = <0x0a 0x17 0x0a 0x0a>;
			clock-names = "core", "iface";
			dmas = <0x1b 0x02 0x1b 0x03>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		spi@78b5000 {
			compatible = "qcom,spi-qup-v2.2.1";
			reg = <0x78b5000 0x600>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x124 0x04>;
			clocks = <0x0a 0x0c 0x0a 0x0a>;
			clock-names = "core", "iface";
			dmas = <0x1b 0x04 0x1b 0x05>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		i2c@78b6000 {
			compatible = "qcom,i2c-qup-v2.2.1";
			reg = <0x78b6000 0x600>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x125 0x04>;
			clocks = <0x0a 0x0e 0x0a 0x0a>;
			clock-names = "core", "iface";
			dmas = <0x1b 0x06 0x1b 0x07>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		spi@78b7000 {
			compatible = "qcom,spi-qup-v2.2.1";
			reg = <0x78b7000 0x600>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			interrupts = <0x00 0x126 0x04>;
			clocks = <0x0a 0x12 0x0a 0x0a>;
			clock-names = "core", "iface";
			dmas = <0x1b 0x08 0x1b 0x09>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		ethernet@3a000000 {
			compatible = "qcom,ipq5332-ppe";
			reg = <0x3a000000 0xbef800>;
			ranges;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			clocks = <0x1c 0x21 0x1c 0x20 0x1c 0x22 0x1c 0x1f 0x0a 0xa3>;
			clock-names = "ppe", "ppe_cfg", "ppe_ipe", "ppe_btq", "gcc_im_sleep";
			resets = <0x1c 0x11>;
			interconnects = <0x1c 0x00 0x1c 0x01 0x1c 0x02 0x1c 0x03 0x0a 0x14 0x0a 0x15 0x0a 0x16 0x0a 0x17>;
			interconnect-names = "ppe", "ppe_cfg", "qos_gen", "timeout_ref";
			status = "okay";

			ethernet-dma {
				compatible = "qcom,ipq5332-edma";
				clocks = <0x1c 0x1e 0x1c 0x1d>;
				clock-names = "sys", "apb";
				resets = <0x1c 0x12 0x1c 0x13>;
				reset-names = "edma_rst", "edma_cfg_rst";
				interrupts = <0x00 0xa3 0x04 0x00 0xa4 0x04 0x00 0xa5 0x04 0x00 0xa6 0x04 0x00 0xa7 0x04 0x00 0xa8 0x04 0x00 0xa9 0x04 0x00 0xaa 0x04 0x00 0xab 0x04 0x00 0xac 0x04 0x00 0xad 0x04 0x00 0xae 0x04 0x00 0x8b 0x04 0x00 0x8c 0x04 0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0xbf 0x04>;
				interrupt-names = "txcmpl_4", "txcmpl_5", "txcmpl_6", "txcmpl_7", "txcmpl_8", "txcmpl_9", "txcmpl_10", "txcmpl_11", "txcmpl_12", "txcmpl_13", "txcmpl_14", "txcmpl_15", "rxdesc_12", "rxdesc_13", "rxdesc_14", "rxdesc_15", "misc";
			};

			ethernet-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@1 {
					reg = <0x01>;
					phy-mode = "2500base-x";
					label = "eth1";
					local-mac-address = [a0 9f 7a 66 fc cd];
					pcs-handle = <0x1d>;
					clocks = <0x1c 0x0e 0x1c 0x0f 0x1c 0x12>;
					clock-names = "mac", "rx", "tx";
					resets = <0x1c 0x0b 0x1c 0x0c 0x1c 0x0d>;
					reset-names = "mac", "rx", "tx";
					phandle = <0x32>;

					fixed-link {
						speed = <0x9c4>;
						full-duplex;
						pause;
					};
				};

				port@2 {
					reg = <0x02>;
					phy-mode = "sgmii";
					label = "wan";
					local-mac-address = [a0 9f 7a 66 fc cc];
					pcs-handle = <0x1e>;
					phy-handle = <0x1f>;
					clocks = <0x1c 0x15 0x1c 0x16 0x1c 0x19>;
					clock-names = "mac", "rx", "tx";
					resets = <0x1c 0x0e 0x1c 0x0f 0x1c 0x10>;
